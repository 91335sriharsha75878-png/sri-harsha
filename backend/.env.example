# ==========================================
# Gemini Chatbot - Backend Environment Config
# ==========================================

# Port the backend server will listen on
PORT=5000

# Your Google Gemini API Key from Google AI Studio
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
# Recommended: gemini-2.5-flash (fast, state-of-the-art)
# Alternatives: gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
DEFAULT_MODEL=gemini-2.5-flash
